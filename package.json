{
  "name": "little-garage",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "docs:scripts": "node scripts/gen-scripts-doc.mjs",
    "icons": "sh scripts/gen-icons.sh",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name little-garage",
    "art:preview": "ART_PREVIEW=art-preview vitest run tests/art-preview.test.tsx",
    "og:image": "OG_IMAGE=public/og-image.svg vitest run tests/og-image.test.tsx && rsvg-convert -w 1200 -h 630 public/og-image.svg -o public/og-image.png && rm public/og-image.svg"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "glob@^11": "^14.0.2",
    "minimatch@^10": "^11.0.1"
  }
}
